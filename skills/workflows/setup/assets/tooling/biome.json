{
	"$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!!**/.agents",
			"!!**/coverage",
			"!!**/dist",
			"!!apps/*/surface/public/**/*.js"
		]
	},
	"linter": {
		"domains": {
			"project": "recommended",
			"react": "recommended",
			"test": "recommended"
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["skills-lock.json"],
			"formatter": {
				"indentStyle": "space",
				"indentWidth": 2
			}
		}
	]
}
