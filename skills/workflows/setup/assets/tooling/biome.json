{
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!!**/.flow",
			"!!**/.turbo",
			"!!**/coverage",
			"!!**/dist",
			"!!apps/*/public/**/*.js"
		]
	},
	"linter": {
		"domains": {
			"project": "recommended",
			"react": "recommended",
			"test": "recommended"
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["skills-lock.json"],
			"formatter": {
				"indentStyle": "space",
				"indentWidth": 2
			}
		}
	]
}
