{
	"$schema": "https://turborepo.com/schema.json",
	"globalDependencies": [".flow/fixtures/**", "tsconfig.base.json"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"typecheck": {
			"dependsOn": ["^typecheck"]
		}
	}
}
