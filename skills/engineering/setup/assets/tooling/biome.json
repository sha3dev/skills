{
	"$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!!**/.agents",
			"!!**/.scratch",
			"!!**/coverage",
			"!!**/dist",
			"!!src/*/assets/**/*.js"
		]
	},
	"linter": {
		"domains": {
			"project": "recommended",
			"react": "recommended",
			"test": "recommended"
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
